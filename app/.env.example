# Wajib diganti sebelum dipakai di luar komputer lokal.
BETTER_AUTH_SECRET=ganti-dengan-random-secret-minimal-32-karakter
BETTER_AUTH_URL=http://127.0.0.1:5173

# Google OAuth Web Application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email akun Google/GitHub yang boleh membuka /admin, pisahkan dengan koma.
ADMIN_EMAILS=

# Nomor bisnis format internasional tanpa tanda +, misalnya 62812xxxxxxxx.
WHATSAPP_NUMBER=

# Otomasi Notifikasi WhatsApp (Opsional: Webhook ke bot WhatsApp Anda)
# WHATSAPP_GATEWAY_URL=http://localhost:3000/send
# WHATSAPP_GATEWAY_KEY=


# QRIS merchant statis milik pemilik usaha. File tidak diletakkan di public/.
QRIS_MERCHANT_NAME=techrey digital
QRIS_IMAGE_PATH=data/merchant/qris-techrey-digital.png
# Untuk Vercel: upload QRIS ke Vercel Blob, lalu isi URL-nya di sini.
# QRIS_BLOB_URL=

# --- Database ---
# Turso cloud database (untuk Vercel hosting).
# Tanpa TURSO_DATABASE_URL, app menggunakan SQLite lokal di data/.
# TURSO_DATABASE_URL=libsql://nama-database-org.turso.io
# TURSO_AUTH_TOKEN=

# --- AI Asisten ---
# Pilih salah satu: OpenRouter (gratis) atau OpenAI (berbayar).
# OpenRouter (gratis, model Hermes)
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxx
# OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# OpenAI (berbayar, legacy)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Tambahkan hanya origin yang benar-benar dipakai di luar localhost.
TRUSTED_ORIGINS=
HOST=127.0.0.1
