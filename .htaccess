# ==============================================================================
# Techrey Digital - Root LiteSpeed / Apache Configuration for Shared Hosting
# ==============================================================================

# 1. Entry point resolution (Guarantees no 403 Forbidden on directory requests)
DirectoryIndex index.php app/dist/index.html prototype/index.html index.html

# 2. Prevent directory indexing without triggering 403 on LiteSpeed
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Note: Do NOT use "Options +FollowSymLinks" as it causes 403 Forbidden on Hostinger LiteSpeed.
# Use SymLinksIfOwnerMatch if needed, or leave to server defaults.
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# 3. Security: Deny direct web access to sensitive server files & folders
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block sensitive hidden files and internal directories
    RewriteRule ^(\.git|\.env.*|node_modules|logs) - [F,L]
    RewriteRule ^app/(src|server|api|data) - [F,L]
    RewriteRule \.(sqlite|sqlite3|db|log|md)$ - [F,L]
</IfModule>

<FilesMatch "^(package|package-lock|tsconfig.*|\.oxlintrc)\.json$">
    Require all denied
</FilesMatch>

# 4. MIME Types for Modern ES Modules, WebP, and Web Fonts
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
    AddType application/json .json
    AddType font/woff .woff
    AddType font/woff2 .woff2
</IfModule>

# 5. Gzip & Brotli Compression for fast loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 6. Rewrite Engine for SPA Routing and Assets Forwarding
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If the request already targets app/dist/ directly, do not rewrite
    RewriteCond %{REQUEST_URI} ^/app/dist/
    RewriteRule ^ - [L]

    # --- A. Static Assets in app/dist/ ---
    # Explicit mapping for Vite assets (/assets/*)
    RewriteRule ^assets/(.*)$ app/dist/assets/$1 [L]

    # Explicit mapping for root favicons
    RewriteRule ^(favicon\.(ico|png)|apple-touch-icon\.png)$ app/dist/$1 [L]

    # General check: If file exists inside app/dist/, serve it from app/dist/
    RewriteCond %{DOCUMENT_ROOT}/app/dist/$1 -f
    RewriteRule ^(.*)$ app/dist/$1 [L]

    # --- B. Primary: SPA Application Route (app/dist) ---
    # If app/dist/index.html exists, forward all non-file requests to app/dist/index.html
    RewriteCond %{DOCUMENT_ROOT}/app/dist/index.html -f
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ app/dist/index.html [L]

    # --- C. Fallback: Prototype Route (prototype/) ---
    # If app/dist/index.html is NOT found, fallback to prototype/
    RewriteCond %{DOCUMENT_ROOT}/app/dist/index.html !-f
    RewriteCond %{DOCUMENT_ROOT}/prototype/$1 -f
    RewriteRule ^(.*)$ prototype/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/app/dist/index.html !-f
    RewriteCond %{DOCUMENT_ROOT}/prototype/index.html -f
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ prototype/index.html [L]
</IfModule>

# 7. Caching policies
<IfModule mod_headers.c>
    # Never cache HTML so users always get the latest SPA release
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Cache hashed Vite assets for 1 year
    <FilesMatch "\.(js|mjs|css|webp|png|jpg|jpeg|svg|ico|woff|woff2)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>
